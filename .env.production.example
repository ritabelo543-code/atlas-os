ATLAS_PUBLIC_URL=https://api.example.com
ATLAS_DATABASE_PATH=/data/atlas.db
# Railway PostgreSQL takes precedence over the SQLite path when configured.
DATABASE_URL=configure-from-railway-postgresql-service
ATLAS_DATABASE_POOL_SIZE=10
CORS_ORIGIN=https://atlas.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=configure-a-public-support-email
AUTH_SECRET=replace-with-at-least-32-random-characters
ATLAS_ADMIN_EMAIL=owner@example.com
ATLAS_REGISTRATION_ENABLED=false
ATLAS_AUTONOMY_ENABLED=false
# Activate only after the persistent worker and official connectors pass the 72-hour soak test.
ATLAS_WORKER_SECRET=replace-with-an-independent-32-character-secret
ATLAS_API_INTERNAL_URL=http://atlas-api.railway.internal:3333
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
AI_API_KEY=configure-in-secret-manager
OPENAI_API_KEY=configure-in-secret-manager
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1-mini
HOTMART_PRODUCTION_CLIENT_ID=configure-in-secret-manager
HOTMART_PRODUCTION_CLIENT_SECRET=configure-in-secret-manager
# HOTMART_PRODUCTION_BASIC=optional-base64-client-id-colon-secret
INSTAGRAM_ACCOUNT_ID=configure-after-meta-app-approval
INSTAGRAM_ACCESS_TOKEN=configure-after-oauth
TIKTOK_ACCESS_TOKEN=configure-after-tiktok-app-approval
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TELEGRAM_BOT_TOKEN=configure-after-botfather-creation
TELEGRAM_DEFAULT_CHAT_ID=configure-after-adding-bot-as-admin
