PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
ATLAS_DATA_DIR=./apps/api/data
# ATLAS_DATABASE_PATH=./apps/api/data/atlas.db
# Required in shared/production environments; use a long random value.
# AUTH_SECRET=replace-with-a-long-random-secret
# Reserve the first administrator and keep public registration closed afterward.
# ATLAS_ADMIN_EMAIL=owner@example.com
ATLAS_REGISTRATION_ENABLED=false
# Use mock without credentials. To enable OpenAI, set AI_PROVIDER=openai and
# provide AI_API_KEY only in your local environment.
AI_PROVIDER=mock
AI_MODEL=gpt-5-mini
AI_TEMPERATURE=0
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=configure-locally-never-commit
# OpenAI-compatible providers: openai, deepseek, gemini and ollama.
# Native Anthropic: AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-4-6 and AI_API_KEY.
# Hotmart production credentials (never commit real values).
# HOTMART_PRODUCTION_CLIENT_ID=configure-locally
# HOTMART_PRODUCTION_CLIENT_SECRET=configure-locally
# HOTMART_PRODUCTION_BASIC=optional-base64-client-id-colon-secret
# Hotmart sandbox uses the same names with HOTMART_SANDBOX_ prefix.
# Image generation (incurs API usage; calls require an explicit user action).
# OPENAI_API_KEY=configure-locally-never-commit
IMAGE_MODEL=gpt-image-1-mini
# Official social publishing credentials. Username/password are never used.
# INSTAGRAM_ACCOUNT_ID=professional-instagram-account-id
# INSTAGRAM_ACCESS_TOKEN=oauth-token
INSTAGRAM_API_VERSION=v23.0
# TIKTOK_ACCESS_TOKEN=user-oauth-token-with-video.publish
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Optional: increases GitHub API rate limits for the read-only plugin.
# GITHUB_TOKEN=configure-locally-never-commit
