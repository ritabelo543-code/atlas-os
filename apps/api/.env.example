PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
ATLAS_DATA_DIR=./apps/api/data
# ATLAS_DATABASE_PATH=./apps/api/data/atlas.db
# Required in shared/production environments; use a long random value.
# AUTH_SECRET=replace-with-a-long-random-secret
# Use mock without credentials. To enable OpenAI, set AI_PROVIDER=openai and
# provide AI_API_KEY only in your local environment.
AI_PROVIDER=mock
AI_MODEL=gpt-5-mini
AI_TEMPERATURE=0
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=configure-locally-never-commit
# OpenAI-compatible providers: openai, deepseek, gemini and ollama.
# Claude requires an OpenAI-compatible gateway; its native protocol is not used by v0.2.
# Optional: increases GitHub API rate limits for the read-only plugin.
# GITHUB_TOKEN=configure-locally-never-commit
