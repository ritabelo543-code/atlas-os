{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @atlas/core build && tsc",
    "start": "node dist/server.js",
    "test": "pnpm --filter @atlas/core build && tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "migrate:postgres": "pnpm run build && node dist/scripts/migrate-to-postgres.js"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/types": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
