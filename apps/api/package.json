{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @atlas/core build && tsc",
    "start": "node dist/server.js",
    "test": "pnpm --filter @atlas/core build && tsc -p tsconfig.test.json && node --test test-dist/test/**/*.test.js"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/types": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
